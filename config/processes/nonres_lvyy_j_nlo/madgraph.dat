import model loop_sm-no_b_mass
define p = g u c d s b u~ c~ d~ s~ b~

# NLO QCD, W -> l nu (single lepton + MET) + 2 photons, FxFx (0j + 1j).
generate p p > e- ve~ a a [QCD]
add process p p > e- ve~ a a j [QCD]
add process p p > e+ ve a a [QCD]
add process p p > e+ ve a a j [QCD]
add process p p > mu- vm~ a a [QCD]
add process p p > mu- vm~ a a j [QCD]
add process p p > mu+ vm a a [QCD]
add process p p > mu+ vm a a j [QCD]

output OUTPUT_PLACEHOLDER
launch

set nevents NEVENTS_PLACEHOLDER
set iseed SEED_PLACEHOLDER

set ebeam1 EBEAM_PLACEHOLDER
set ebeam2 EBEAM_PLACEHOLDER

set ptgmin 32

# FxFx NLO merging: embed clustering history in LHE for Pythia 8
set ickkw 3
