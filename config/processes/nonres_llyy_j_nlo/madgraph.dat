import model loop_sm-no_b_mass
define p = g u c d s b u~ c~ d~ s~ b~

# NLO QCD, Z/gamma* -> l+ l- (charged dilepton) + 2 photons, FxFx (0j + 1j).
generate p p > e- e+ a a [QCD]
add process p p > e- e+ a a j [QCD]
add process p p > mu- mu+ a a [QCD]
add process p p > mu- mu+ a a j [QCD]

output OUTPUT_PLACEHOLDER
launch

set nevents NEVENTS_PLACEHOLDER
set iseed SEED_PLACEHOLDER

set ebeam1 EBEAM_PLACEHOLDER
set ebeam2 EBEAM_PLACEHOLDER

set ptgmin 32

# FxFx NLO merging: embed clustering history in LHE for Pythia 8
set ickkw 3

# FxFx jet definition: kT with R=1. ptj must stay below half the merging
# scale (JetMatching:qCut in pythia.cmnd) and match JetMatching:qCutME.
set jetalgo 1.0
set jetradius 1.0
set ptj 10
